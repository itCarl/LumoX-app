{
  "name": "lumox-app",
  "version": "0.1.0",
  "description": "Lumox — Wireless DMX Controller (Electron)",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "icons": "electron tools/make-icons.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:report": "playwright show-report e2e/report",
    "start": "npm run build && electron .",
    "dev": "node build.mjs --watch --serve",
    "headless": "tsx src/headless.ts",
    "frame": "tsx tools/frame.ts",
    "port-qxf": "tsx tools/qxf-to-lumox.ts",
    "shot": "node tools/shot.mjs",
    "cli": "tsx cli/lumox-cli.ts",
    "validate": "tsx examples/19-validate-fixtures.ts",
    "example": "tsx",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/cli": "^4.3.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.19.21",
    "electron": "^42.4.1",
    "electronmon": "^2.0.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.13.0",
    "fast-xml-parser": "^5.9.3",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "abletonlink": "^1.0.0",
    "easymidi": "^3.1.0"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.3",
    "culori": "^4.0.2"
  }
}
