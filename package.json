{
  "name": "lumox-app",
  "version": "0.1.0",
  "description": "Lumox — Wireless DMX Controller (Electron)",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "icons": "electron tools/make-icons.cjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "node build.mjs --watch --serve",
    "headless": "tsx src/headless.ts",
    "cli": "tsx cli/lumox-cli.ts",
    "validate": "tsx examples/19-validate-fixtures.ts",
    "example": "tsx",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@tailwindcss/cli": "^4.3.1",
    "@types/node": "^22.19.21",
    "electron": "^42.4.1",
    "electronmon": "^2.0.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "optionalDependencies": {
    "easymidi": "^3.1.0"
  }
}
