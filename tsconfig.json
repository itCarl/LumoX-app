{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],

    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "allowJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src", "main", "cli", "renderer", "examples", "test", "preload.ts", "build.mjs", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "renderer/dist"]
}
