{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumox.local/schemas/lumox-fixture.schema.json",
  "title": "Lumox Fixture File",
  "description": "Top-level format for .lumox.json / .lfx fixture profile files.",
  "type": "object",
  "required": ["version", "definitions"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/FixtureDefinition" }
    }
  },
  "additionalProperties": false,

  "$defs": {
    "FixtureDefinition": {
      "type": "object",
      "required": ["manufacturer", "model", "modes"],
      "properties": {
        "id":           { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "model":        { "type": "string", "minLength": 1 },
        "type":         { "type": "string", "examples": [
          "PAR", "Moving Head", "Strobe", "LED Bar", "Dimmer",
          "Smoke", "Laser", "Scanner", "Color Changer", "Effect", "Other"
        ]},
        "emitters":     { "type": "integer", "minimum": 1, "maximum": 1024 },
        "emitterLayout": {
          "type": "array",
          "description": "Per-emitter normalized positions (0..1) for matrix effects.",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "meta":         { "$ref": "#/$defs/Meta" },
        "physical":     { "$ref": "#/$defs/Physical" },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Mode" }
        }
      },
      "additionalProperties": false
    },

    "Meta": {
      "type": "object",
      "description": "Authorship and provenance. All fields optional.",
      "properties": {
        "author":     { "type": ["string", "null"] },
        "version":    { "type": ["string", "null"], "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$" },
        "createdAt":  { "type": ["string", "null"], "format": "date-time" },
        "modifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "source":     { "type": ["string", "null"] },
        "notes":      { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },

    "Physical": {
      "type": "object",
      "description": "Real-world specs. All sub-objects optional.",
      "properties": {
        "dimensions": {
          "type": ["object", "null"],
          "properties": {
            "width":  { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 },
            "depth":  { "type": "number", "minimum": 0 },
            "unit":   { "type": "string", "enum": ["mm", "cm"] }
          },
          "additionalProperties": false
        },
        "weight": {
          "type": ["object", "null"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "unit":  { "type": "string", "enum": ["kg", "g"] }
          },
          "additionalProperties": false
        },
        "bulb": {
          "type": ["object", "null"],
          "properties": {
            "type":              { "type": ["string", "null"] },
            "lumens":            { "type": ["number", "null"], "minimum": 0 },
            "colourTemperature": { "type": ["number", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "lens": {
          "type": ["object", "null"],
          "properties": {
            "name":       { "type": ["string", "null"] },
            "degreesMin": { "type": ["number", "null"], "minimum": 0, "maximum": 360 },
            "degreesMax": { "type": ["number", "null"], "minimum": 0, "maximum": 360 }
          },
          "additionalProperties": false
        },
        "focus": {
          "type": ["object", "null"],
          "properties": {
            "type":    { "type": ["string", "null"], "examples": ["Fixed", "Head", "Mirror"] },
            "panMax":  { "type": ["number", "null"], "minimum": 0, "maximum": 720 },
            "tiltMax": { "type": ["number", "null"], "minimum": 0, "maximum": 720 }
          },
          "additionalProperties": false
        },
        "power": {
          "type": ["object", "null"],
          "properties": {
            "consumption": { "type": "number", "minimum": 0 },
            "unit":        { "type": "string", "enum": ["W", "kW"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "Mode": {
      "type": "object",
      "required": ["name", "channels"],
      "properties": {
        "id":       { "type": "string", "minLength": 1 },
        "name":     { "type": "string", "minLength": 1 },
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/Channel" },
              { "type": "null" }
            ]
          }
        }
      },
      "additionalProperties": false
    },

    "Channel": {
      "type": "object",
      "required": ["typeId"],
      "properties": {
        "name":         { "type": "string" },
        "typeId":       { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "defaultValue": { "type": "integer", "minimum": 0, "maximum": 255 },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/Capability" }
        }
      },
      "additionalProperties": false
    },

    "Capability": {
      "type": "object",
      "required": ["kind", "min", "max"],
      "properties": {
        "kind":  { "type": "string", "examples": ["range", "color", "gobo", "shutter", "effect"] },
        "min":   { "type": "integer", "minimum": 0, "maximum": 255 },
        "max":   { "type": "integer", "minimum": 0, "maximum": 255 },
        "label": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "color" } } },
          "then": { "properties": {
            "color": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" }
          }}
        },
        { "if": { "properties": { "kind": { "const": "gobo" } } },
          "then": { "properties": {
            "image": { "type": ["string", "null"] },
            "shake": { "type": "boolean" }
          }}
        },
        { "if": { "properties": { "kind": { "const": "shutter" } } },
          "then": { "properties": {
            "mode":   { "type": "string", "enum": ["open", "closed", "strobe", "pulse", "random"] },
            "rateHz": { "type": ["number", "null"], "minimum": 0 }
          }}
        },
        { "if": { "properties": { "kind": { "const": "effect" } } },
          "then": { "properties": {
            "effectName": { "type": "string" }
          }}
        }
      ],
      "additionalProperties": true
    }
  }
}
